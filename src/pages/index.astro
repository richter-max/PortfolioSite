---
// / — On Track.
import SideLayout from '../layouts/SideLayout.astro';
import OnHero from '../components/v3/OnHero.astro';
import Trail from '../components/v3/Trail.astro';
import Training from '../components/v3/Training.astro';
import Journal from '../components/v3/Journal.astro';
import Bridge from '../components/v3/Bridge.astro';
import { getRaces } from '../data/races';
import tt from '../data/tabletennis.json';

const { upcoming, results } = await getRaces();

// Table tennis: refreshed daily from the team's click-TT page (see
// scripts/fetch-tabletennis.mjs); the TTR is kept by hand.
const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const ttNext = tt.next
  ? (() => {
      const d = new Date(`${tt.next.date}T12:00:00Z`);
      return `${DAYS[d.getUTCDay()]} ${d.getUTCDate()} ${MON[d.getUTCMonth()]}, ${tt.next.home ? 'home vs' : 'away at'} ${tt.next.opponent}`;
    })()
  : null;
const ttFacts = [
  tt.ttr ? `TTR ${tt.ttr}` : null,
  tt.me ? `Singles ${tt.me.singles}` : null,
  tt.me ? `Table: ${tt.tablePlace}.` : null,
].filter(Boolean);
---

<SideLayout side="on">
  <OnHero races={upcoming} />
  <Trail upcoming={upcoming} results={results} />

  <div class="stack">
    <Training />


    <Journal />

    <section class="offseason wrap" aria-label="Table tennis">
      <span class="label">Table tennis · {tt.season}</span>
      <span class="offseason__what">{tt.league}, {tt.team}</span>
      {ttFacts.length > 0 && <span class="data">{ttFacts.join(' · ')}</span>}
      {ttNext && <span class="data offseason__next">Next: {ttNext}</span>}
    </section>

    <Bridge
      to="off"
      text="Dual student in Computer Science, IT security, at Bosch. Heading for AI security."
    />
  </div>
</SideLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
    padding-top: var(--space-6);
  }
  .offseason {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .offseason > * {
    padding-top: 22px;
  }
  .offseason::before {
    content: '';
    flex: 0 0 100%;
    border-top: 1px solid var(--line);
    margin-bottom: -22px;
  }
  .offseason__what {
    flex: 1 1 300px;
    font-size: 15px;
  }
  .offseason__next {
    color: var(--ink-muted);
  }
</style>
