---
// / — On Track.
import SideLayout from '../layouts/SideLayout.astro';
import OnHero from '../components/v3/OnHero.astro';
import Trail from '../components/v3/Trail.astro';
import Training from '../components/v3/Training.astro';
import Journal from '../components/v3/Journal.astro';
import Bridge from '../components/v3/Bridge.astro';
import { getRaces } from '../data/races';

const { upcoming, results } = await getRaces();
---

<SideLayout side="on">
  <OnHero races={upcoming} />
  <Trail upcoming={upcoming} results={results} />

  <div class="stack">
    <Training />


    <Journal />

    <section class="offseason wrap" aria-label="Off season">
      <span class="label">Off season</span>
      <span class="offseason__what">Table tennis, Landesliga, DJK Seifriedsberg</span>
      <span class="data">TTR 1670 → 1757 · 2025/26</span>
    </section>

    <Bridge
      to="off"
      text="Dual student in Computer Science, IT security, at Bosch. Heading for AI security."
    />
  </div>
</SideLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
    padding-top: var(--space-6);
  }
  .offseason {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .offseason > * {
    padding-top: 22px;
  }
  .offseason::before {
    content: '';
    flex: 0 0 100%;
    border-top: 1px solid var(--line);
    margin-bottom: -22px;
  }
  .offseason__what {
    flex: 1 1 300px;
    font-size: 15px;
  }
</style>
