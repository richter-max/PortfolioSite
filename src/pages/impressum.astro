---
import ProseLayout from '../layouts/ProseLayout.astro';
import { SITE } from '../data/site';
const L = SITE.legal;
---
<ProseLayout side="off" lang="de" title="Impressum" kicker="LEGAL · IMPRESSUM" noindex>
  <h2>Angaben gemäß § 5 DDG</h2>
  <address>
    {L.fullName}<br />
    {L.street}<br />
    {L.postalCode} {L.city}<br />
    {L.country}
  </address>
  <h2>Kontakt</h2>
  <p>
    E-Mail: <a href={`mailto:${SITE.author.email}`}>{SITE.author.email}</a>
  </p>
  <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
  <address>
    {L.responsibleName}, Anschrift wie oben
  </address>
  <h2>Hinweis</h2>
  <p>
    Dies ist eine private Website ohne kommerzielle Absicht. Für Inhalte
    externer Links sind ausschließlich deren Betreiber verantwortlich.
  </p>
</ProseLayout>
