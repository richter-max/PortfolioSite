---
// /off-track — Off Track: IT security, the degree, the path there.
import SideLayout from '../layouts/SideLayout.astro';
import IdBadge from '../components/v3/IdBadge.astro';
import ScanTerminal from '../components/v3/ScanTerminal.astro';
import AegisCase from '../components/v3/AegisCase.astro';
import Bridge from '../components/v3/Bridge.astro';
import { SITE } from '../data/site';
import { fields, projects, path, degree, roadmap, blockRange } from '../data/offtrack';

// Which block of the degree is running today (build time; degree.js
// recomputes in the browser, so it is right between daily builds).
const todayIso = new Date().toISOString().slice(0, 10);
const blocks = degree.years.flatMap((y, yi) =>
  y.blocks.map(([kind, name, sub], qi) => {
    const n = yi * 4 + qi;
    const { start, end } = blockRange(n);
    const days = Math.round((Date.parse(end) - Date.parse(start)) / 864e5);
    const day = Math.floor((Date.parse(todayIso) - Date.parse(start)) / 864e5) + 1;
    const now = todayIso >= start && todayIso < end;
    return { yi, qi, kind, name, sub, start, end, now, days, day };
  }),
);
const blockOf = (yi: number, qi: number) => blocks[yi * 4 + qi];

const CHIP: Record<string, string> = { focus: 'Focus', groundwork: 'Groundwork', next: 'Next' };

// Written weekly by .github/workflows/scan-self.yml. Until the first scan
// exists, the hero shows the badge on its own.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const scanFile = Object.values(import.meta.glob('../data/scan.json', { eager: true, import: 'default' }))[0] as any;
---

<SideLayout side="off">
  <section class="offhero">
    <canvas class="offhero__grid" data-grid aria-hidden="true"></canvas>
    <div class="offhero__inner wrap">
      <div class="offhero__head">
        <p class="label">Off track · IT security</p>
        <h1 class="display-xl settle">Studying IT security.<br />Heading for AI security.</h1>
      </div>
      <div class="offhero__text">
        <div class="offhero__copy">
          <p>
            Dual B.Sc. Computer Science with an IT security focus at Bosch, since
            October 2026. Before that: an apprenticeship as a software developer
            and eight months as an IT key user. It's early. On the side I build
            security tools, test them until they fail, and write down what I learn.
          </p>
          <p class="label">On track: training for an 81 km night race · <a class="link" href="/">Switch <span class="arr">→</span></a></p>
        </div>
      </div>
      {scanFile ? (
        <div class="offhero__side">
          <ScanTerminal scan={scanFile} />
          <div class="offhero__clip"><IdBadge /></div>
        </div>
      ) : (
        <IdBadge />
      )}
    </div>
  </section>

  <div class="stack">
    <section id="fields" class="wrap block" aria-labelledby="fields-h">
      <div class="block__head">
        <h2 id="fields-h" class="display-m">Fields</h2>
        <span class="label">What I work on, and how far I am</span>
      </div>
      <ul class="fields">
        {fields.map((f) => (
          <li class="field">
            <span class:list={['chip', `chip--${f.status}`]}>{CHIP[f.status]}</span>
            <h3 class="display-xs field__name">{f.name}</h3>
            <p>{f.text}</p>
            <span class="field__proof data">
              {'href' in f && f.href ? <a class="link" href={f.href}><span class="arr">→</span> {f.proof}</a> : f.proof}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <AegisCase />

    <section id="projects" class="wrap projects" aria-label="Projects">
      {projects.map((p) => (
        <article class="project">
          <span class="label-s">Project · {p.tag}</span>
          <h3 class="display-s">{p.name}</h3>
          <p>{p.text}</p>
          <span class="label-s">{p.note}</span>
          {p.href && <a class="label-s project__link link" href={p.href}>Source <span class="arr">↗</span></a>}
        </article>
      ))}
    </section>

    <section class="wrap block" aria-labelledby="path-h">
      <div class="block__head">
        <h2 id="path-h" class="display-m">How I got here</h2>
        <span class="label">Practice first, theory second</span>
      </div>
      <ol class="path">
        {path.map((s) => (
          <li class:list={['path__step', { 'is-now': s.now }]}>
            <span class="label-s">{s.when}</span>
            <strong class="display-xs">{s.title}</strong>
            <span>{s.text}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap block" aria-labelledby="degree-h">
      <div class="block__head">
        <h2 id="degree-h" class="display-m">How the degree works</h2>
        <p class="block__intro">
          Dual study with DHBW Ravensburg, Campus Friedrichshafen. Three years in
          blocks of about three months: theory at university, practice at Bosch.
          Each theory phase ends with an exam week.
        </p>
      </div>
      <ol class="degree__list" aria-label="Block plan">
        {degree.years.map((y) => (
          <li>
            <span class="display-xs">{y.label} <span class="label-s">{y.cal}</span></span>
            <ol>
              {y.blocks.map((_, i) => {
                const b = blockOf(degree.years.indexOf(y), i);
                return (
                  <li class:list={['blk', b.kind === 'P' ? 'blk--p' : 'blk--t', { 'is-now': b.now }]} data-blk data-start={b.start} data-end={b.end} data-name={b.name}>
                    <span class="label-s degree__q">{degree.quarters[i]}</span>
                    <strong data-blk-name>{b.now ? `Now · ${b.name}` : b.name}</strong>
                    <span>{b.sub}</span>
                    <span class="blk__prog" data-blk-prog hidden={!b.now}>
                      <span class="blk__bar"><span style={`width:${b.now ? ((b.day / b.days) * 100).toFixed(1) : 0}%`} data-blk-fill></span></span>
                      <span class="label-s" data-blk-day>{b.now ? `Day ${b.day} of ${b.days}` : ''}</span>
                    </span>
                  </li>
                );
              })}
            </ol>
          </li>
        ))}
      </ol>
      <div class="degree__scroll">
        <table class="degree">
          <caption class="label-s">Block plan · filled: practice at Bosch · outlined: theory at DHBW</caption>
          <thead>
            <tr>
              <td></td>
              {degree.quarters.map((q) => <th scope="col" class="label-s">{q}</th>)}
            </tr>
          </thead>
          <tbody>
            {degree.years.map((y) => (
              <tr>
                <th scope="row"><span class="display-xs">{y.label}</span><span class="label-s">{y.cal}</span></th>
                {y.blocks.map((_, i) => {
                  const b = blockOf(degree.years.indexOf(y), i);
                  return (
                    <td class:list={['blk', b.kind === 'P' ? 'blk--p' : 'blk--t', { 'is-now': b.now }]} data-blk data-start={b.start} data-end={b.end} data-name={b.name}>
                      <strong data-blk-name>{b.now ? `Now · ${b.name}` : b.name}</strong>
                      <span>{b.sub}</span>
                      <span class="blk__prog" data-blk-prog hidden={!b.now}>
                        <span class="blk__bar"><span style={`width:${b.now ? ((b.day / b.days) * 100).toFixed(1) : 0}%`} data-blk-fill></span></span>
                        <span class="label-s" data-blk-day>{b.now ? `Day ${b.day} of ${b.days}` : ''}</span>
                      </span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="roadmap" class="wrap block" aria-labelledby="road-h">
      <div class="block__head">
        <h2 id="road-h" class="display-m">Roadmap</h2>
        <span class="label">Same rule as on track: say it, then report back</span>
      </div>
      <ul class="road">
        {roadmap.map((r) => (
          <li>
            <span class="data road__state">{r.state}</span>
            <span class="display-xs road__what">{r.what}</span>
            <span class="road__note">{r.note}</span>
          </li>
        ))}
      </ul>
    </section>


    <Bridge to="on" text="Training for KAT100: 81 km and 4,850 m of climbing, starting at midnight in Kitzbühel." />

    <section class="wrap contact" aria-labelledby="contact-h">
      <div>
        <h2 id="contact-h" class="label">Contact</h2>
        <p class="contact__mail">{SITE.author.email}</p>
      </div>
      <span class="contact__links label">
        <a href={SITE.author.github}>GitHub</a>
        <a href={SITE.author.linkedin}>LinkedIn</a>
        <a href="/.well-known/security.txt">security.txt</a>
      </span>
    </section>
  </div>
</SideLayout>

<script>
  import '../scripts/v3/grid.js';
  import '../scripts/v3/degree.js';
</script>

<style>
  .offhero {
    position: relative;
    overflow: hidden;
    margin-top: -88px;
    padding-top: 88px;
  }
  .offhero__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--ink);
  }
  .offhero__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-8);
  }
  .offhero__head {
    flex: 1 1 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .offhero__text {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .offhero__copy {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
  }
  .offhero__copy {
    flex-direction: column;
  }
  .offhero__copy p {
    margin: 0;
    max-width: 48ch;
  }
  .offhero :global(.badgescene) {
    flex: 0 1 320px;
    margin-inline: auto;
  }
  @media (max-width: 640px) {
    .offhero .offhero__side {
      padding-top: 84px;
    }
  }
  .offhero__side {
    position: relative;
    flex: 1 1 460px;
    max-width: 560px;
    min-width: 0;
    padding-top: 110px;
  }
  /* Wide screens: tuck the terminal up next to the short last line of the
     headline, so terminal and badge sit above the fold. */
  @media (min-width: 1360px) {
    .offhero .offhero__side {
      margin-top: calc(-0.82 * min(11.5vw, 176px) - 148px);
    }
  }
  /* The badge is clipped onto the terminal's corner. */
  .offhero__clip {
    position: absolute;
    top: 0;
    right: -44px;
    z-index: 2;
    width: 140px;
    transform: rotate(5deg);
  }
  .offhero__clip :global(.badgescene) {
    max-width: none;
  }
  .offhero__clip :global(.badge__body dl),
  .offhero__clip :global(.badge__tag) {
    display: none;
  }
  /* Small clipped badge: more photo, closer crop. */
  .offhero__clip :global(.badge) {
    grid-template-rows: 62% 1fr;
  }
  .offhero__clip :global(.badge__photo img) {
    transform: scale(1.75);
    transform-origin: 52% 17%;
  }
  .offhero__clip :global(.badge__name) {
    font-size: 20px;
  }
  @media (max-width: 640px) {
    .offhero__clip {
      width: 110px;
      top: 20px;
      right: -4px;
    }
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
    padding-top: var(--space-6);
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--space-7);
  }
  .block__intro {
    flex: 0 1 440px;
    margin: 0;
  }

  .fields,
  .road {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line-strong);
  }
  .field {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 32px;
    padding: 22px 14px;
    border-top: 1px solid var(--line-strong);
    transition:
      background-color var(--dur-ui),
      color var(--dur-ui);
  }
  .field:hover {
    background: var(--ink);
    color: var(--surface);
  }
  .field:hover .field__proof,
  .field:hover .field__proof a {
    color: inherit;
  }
  .field__name {
    flex: 1 1 300px;
    min-width: 0;
    font-size: clamp(32px, 3.6vw, 52px);
  }
  .field p {
    flex: 1 1 320px;
    min-width: 0;
    margin: 0;
    font-size: 16px;
  }
  .field__proof {
    flex: 0 0 190px;
    color: var(--ink-muted);
  }
  .field__proof a {
    color: var(--ink);
  }
  .chip {
    flex: 0 0 112px;
    box-sizing: border-box;
    text-align: center;
    align-self: center;
    padding: 4px 10px;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .chip--focus {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }
  .field:hover .chip--focus {
    background: var(--surface);
    border-color: var(--surface);
    color: var(--ink);
  }
  .chip--next {
    border-style: dashed;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: 18px;
    border-top: 1px solid var(--line-strong);
  }
  .project p {
    margin: 0;
    font-size: 16px;
  }
  .project__link {
    color: var(--ink);
  }

  .path {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .path__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 24px 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .path__step.is-now {
    border-top-width: 3px;
  }

  .degree__scroll {
    overflow-x: auto;
  }
  .degree__list {
    display: none;
  }
  @media (max-width: 699px) {
    .degree__scroll {
      display: none;
    }
    .degree__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .degree__list ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin: var(--space-3) 0 0;
      padding: 0;
      list-style: none;
    }
    .degree__list .blk {
      height: auto;
      min-height: 104px;
      box-sizing: border-box;
    }
    .degree__q {
      display: block;
      margin-bottom: 6px;
      color: inherit;
      opacity: 0.75;
    }
  }
  .degree {
    min-width: 640px;
    width: 100%;
    /* four equal quarters, whatever text a block holds */
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 6px;
    margin-inline: -6px;
  }
  .degree caption {
    caption-side: bottom;
    text-align: left;
    padding: var(--space-3) 6px 0;
  }
  .degree th {
    text-align: left;
    font-weight: 400;
  }
  .degree thead td,
  .degree tbody th {
    width: 110px;
    vertical-align: middle;
  }
  .degree tbody th span {
    display: block;
  }
  .blk {
    height: 92px;
    padding: 12px;
    vertical-align: top;
  }
  .blk strong {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1;
    text-transform: uppercase;
  }
  .blk span {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .blk--p {
    background: var(--ink);
    color: var(--surface);
  }
  .blk--t {
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .blk.is-now {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .blk__prog {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;
  }
  .blk__prog[hidden] {
    display: none;
  }
  .blk__bar {
    display: block;
    height: 4px;
    background: color-mix(in srgb, currentColor 25%, transparent);
  }
  .blk__bar > span {
    display: block;
    height: 100%;
    background: currentColor;
  }
  .blk--p .blk__prog .label-s {
    color: inherit;
    opacity: 0.85;
  }

  .road li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 32px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .road__state {
    flex: 0 0 150px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .road__what {
    flex: 1 1 340px;
    min-width: 0;
    font-weight: 500;
  }
  .road__note {
    flex: 0 1 300px;
    min-width: 0;
    color: var(--ink-muted);
  }


  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
  }
  .contact__mail {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-stretch: 75%;
    font-weight: 600;
    font-size: clamp(26px, 3.4vw, 44px);
    overflow-wrap: anywhere;
    user-select: all;
  }
  .contact__links {
    display: flex;
    gap: var(--space-5);
  }
  .contact__links a {
    color: var(--ink);
    text-decoration: none;
  }
</style>
