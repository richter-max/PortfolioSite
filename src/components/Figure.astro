---
// Figure.astro — the page's one moving thing.
// Ports the v1 ContactRunner: Draco-compressed self-scan, RoomEnvironment
// IBL, NoToneMapping with a light budget that stays under 1.0 so the
// photo textures don't clip (the tuning that worked in v1 is kept 1:1).
// Rewritten without React, plus what was missing:
//   - Three.js and the model load on page load, not on scroll, so the
//     figure is already standing there when the section is reached.
//     Kicked off after `window.load` so the 6 MB download doesn't
//     compete with fonts and first paint.
//   - rotation only starts once the section is actually in view
//   - prefers-reduced-motion → renders one static frame, no rotation
//   - rendering pauses when offscreen or the tab is hidden
//   - if WebGL/model fail, the stage collapses and the caption remains
//   - the light budget is re-tuned when the theme changes: the canvas
//     is alpha, so the scan sits directly on the page ground, and a
//     model lit for paper reads as pasted-on over near-black
// new commit
---

<section class="figure wrap" aria-hidden="true">
  <div class="figure__stage" id="figure-stage" data-figure></div>
  <p class="meta figure__caption">FIG. A · THE AUTHOR · 1 REV / 12 S</p>
</section>

<script>
  // Seconds per full revolution. Mirrored in the caption above.
  const REV_SECONDS = 12;

  // Light budget per ground. The light values are v1's, kept 1:1. The
  // dark ones pull the key down and the room reflection further, so the
  // scan reads as an object lit in a dark room rather than a cutout
  // dropped onto one. The sum stays under 1.0 either way — that is what
  // keeps the photo textures from clipping under NoToneMapping.
  const LIGHTING = {
    light: { key: 0.5, fill: 0.15, env: 0.4 },
    dark: { key: 0.36, fill: 0.1, env: 0.26 },
  };

  /** The ground currently under the canvas. */
  function currentTheme() {
    const pinned = document.documentElement.dataset.theme;
    if (pinned === 'dark' || pinned === 'light') return pinned;
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light';
  }

  const stage = document.querySelector('[data-figure]');

  async function init() {
    const [THREE, { GLTFLoader }, { DRACOLoader }, { RoomEnvironment }] =
      await Promise.all([
        import('three'),
        import('three/examples/jsm/loaders/GLTFLoader.js'),
        import('three/examples/jsm/loaders/DRACOLoader.js'),
        import('three/examples/jsm/environments/RoomEnvironment.js'),
      ]);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const width = stage.clientWidth;
    const height = stage.clientHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, width / height, 0.1, 1000);
    camera.position.set(0, 0, 5);

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    } catch {
      stage.remove();
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.NoToneMapping;
    stage.appendChild(renderer.domElement);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    pmrem.dispose();

    let budget = LIGHTING[currentTheme()];

    const key = new THREE.DirectionalLight(0xffffff, budget.key);
    key.position.set(3, 4, 3);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xffffff, budget.fill);
    fill.position.set(-2, 1, -2);
    scene.add(fill);

    const draco = new DRACOLoader();
    draco.setDecoderPath('/draco/');
    draco.setDecoderConfig({ type: 'js' });
    const loader = new GLTFLoader();
    loader.setDRACOLoader(draco);

    let pivot = null;
    const materials = [];
    const clock = new THREE.Clock();

    // Loop state, declared here because applyTheme() below reads rafId
    // to decide whether it must repaint or whether the next frame will.
    let rafId = null;
    let visible = false;
    let everSeen = false;

    /** Re-tune for a ground. Repaints only when the loop is parked. */
    function applyTheme(theme) {
      budget = LIGHTING[theme] ?? LIGHTING.light;
      key.intensity = budget.key;
      fill.intensity = budget.fill;
      for (const m of materials) {
        if ('envMapIntensity' in m) m.envMapIntensity = budget.env;
        m.needsUpdate = true;
      }
      // While rotating, the next frame picks this up on its own.
      if (rafId === null && pivot) renderer.render(scene, camera);
    }

    document.addEventListener('themechange', (e) => {
      applyTheme(e.detail?.theme ?? currentTheme());
    });

    loader.load(
      '/models/richter.opt.glb',
      (gltf) => {
        const model = gltf.scene;
        model.traverse((child) => {
          if (!child.isMesh || !child.material) return;
          const mats = Array.isArray(child.material) ? child.material : [child.material];
          for (const m of mats) {
            if ('metalness' in m) m.metalness = 0;
            if ('roughness' in m) m.roughness = 0.6;
            if ('envMapIntensity' in m) m.envMapIntensity = budget.env;
            if (m.map) m.map.colorSpace = THREE.SRGBColorSpace;
            m.needsUpdate = true;
            materials.push(m);
          }
        });

        const box = new THREE.Box3().setFromObject(model);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());
        model.position.sub(center);

        pivot = new THREE.Group();
        // A quarter turn off dead-front reads better as a static frame.
        if (reduced) pivot.rotation.y = Math.PI / 5;
        pivot.add(model);
        scene.add(pivot);

        const maxDim = Math.max(size.x, size.y, size.z);
        const fov = camera.fov * (Math.PI / 180);
        const distance = ((maxDim / 2) / Math.tan(fov / 2)) * 1.6;
        camera.position.set(0, 0, distance);
        camera.lookAt(0, 0, 0);
        camera.near = distance / 100;
        camera.far = distance * 100;
        camera.updateProjectionMatrix();

        // The model is ready well before anyone scrolls here. Render
        // the static frame now; rotation is a separate question,
        // answered by the observer below.
        renderer.render(scene, camera);

        // If the section was already in view while the model was still
        // downloading, the observer has nothing left to fire.
        if (visible) {
          if (!everSeen && !reduced) {
            everSeen = true;
            pivot.rotation.y = 0;
          }
          start();
        }
      },
      undefined,
      () => stage.remove(),
    );

    // ── Loop: only while visible, tab shown, and motion allowed ────
    function frame() {
      rafId = null;
      if (!visible || document.hidden) return;
      const delta = clock.getDelta();
      if (pivot) pivot.rotation.y += (delta * Math.PI * 2) / REV_SECONDS;
      renderer.render(scene, camera);
      rafId = requestAnimationFrame(frame);
    }
    function start() {
      if (!reduced && rafId === null) {
        clock.getDelta(); // swallow paused time so it doesn't jump
        rafId = requestAnimationFrame(frame);
      }
    }

    new IntersectionObserver(
      (entries) => {
        visible = entries[0].isIntersecting;
        if (visible) {
          // First time the section is genuinely seen, square the
          // figure up before it starts turning. Reduced-motion keeps
          // its off-axis static frame instead.
          if (!everSeen && pivot && !reduced) {
            everSeen = true;
            pivot.rotation.y = 0;
            renderer.render(scene, camera);
          }
          start();
        }
      },
      { rootMargin: '0px' },
    ).observe(stage);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) start();
    });

    window.addEventListener('resize', () => {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      if (reduced) renderer.render(scene, camera);
    });

  }

  // Load on page load rather than on scroll, but after the critical
  // resources are done — the 6 MB model shouldn't fight the fonts for
  // bandwidth. Rotation still waits for the section to be in view.
  if (stage) {
    if (document.readyState === 'complete') {
      init();
    } else {
      window.addEventListener('load', init, { once: true });
    }
  }
</script>

<style>
  .figure {
    border-top: 1px solid var(--hairline);
    padding-block: clamp(40px, 6vh, 72px) clamp(32px, 5vh, 56px);
  }
  .figure__stage {
    height: min(520px, 70vh);
  }
  .figure__caption {
    margin-top: 12px;
    text-align: center;
  }
</style>
