---
// Writing.astro — three posts, listed like a table of contents.
import SectionHead from './SectionHead.astro';
import { sortedPosts } from '../data/posts';

const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
function fmt(iso: string) {
  const [y, m] = iso.split('-').map(Number);
  return `${MONTHS[m - 1]} ${y}`;
}
const posts = sortedPosts();
---

<section id="writing" class="writing wrap">
  <SectionHead num="03" label="WRITING" />
  <ol class="posts">
    {posts.map((p) => (
      <li class="post">
        <a class="post__link" href={`/blog/${p.slug}`}>
          <div class="post__meta meta">
            <span>{fmt(p.pubDate)}</span>
            {p.revised && <span class="post__rev">REV {fmt(p.revised)}</span>}
            <span>{p.readTime}</span>
          </div>
          <h3 class="post__title">{p.title}</h3>
          <p class="post__desc">{p.description}</p>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .writing {
    border-top: 1px solid var(--hairline);
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  .posts {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--hairline);
  }
  .post__link {
    display: grid;
    grid-template-columns: 180px 1fr;
    grid-template-areas: 'meta title' 'meta desc';
    gap: 4px 32px;
    padding-block: 24px;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .post__link {
      grid-template-columns: 1fr;
      grid-template-areas: 'meta' 'title' 'desc';
    }
  }
  .post__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .post__rev {
    color: var(--accent-ink);
  }
  .post__title {
    grid-area: title;
    font-size: 1.25rem;
    font-weight: 560;
    letter-spacing: -0.015em;
  }
  .post__link:hover .post__title {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--hairline-strong);
  }
  .post__desc {
    grid-area: desc;
    color: var(--ink-mid);
    font-size: 0.9375rem;
    max-width: 62ch;
  }
</style>
