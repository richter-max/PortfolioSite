---
// Nav.astro — one hairline row. No hamburger, no palette.
// The links are the section list; on narrow screens they wrap.
//
// The one script here is the theme toggle. It is rendered `hidden` and
// unhidden by that script, so a reader without JS never sees a control
// that cannot work — they get the system theme, which is the right
// answer anyway. The button names the theme it will switch *to*.
const links = [
  { label: 'WORK', href: '#work' },
  { label: 'FOUNDATIONS', href: '#foundations' },
  { label: 'WRITING', href: '#writing' },
  { label: 'SPORT', href: '#sport' },
  { label: 'CONTACT', href: '#contact' },
];
---

<header class="nav">
  <div class="wrap nav__row">
    <a class="nav__mark meta" href="/">RICHTER,&nbsp;M.</a>
    <nav aria-label="Sections">
      <ul class="nav__links">
        {links.map((l) => (
          <li><a class="meta nav__link" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <button
      class="meta nav__theme"
      type="button"
      data-theme-toggle
      hidden
      aria-label="Switch theme"
    >
      <span class="nav__swatch" aria-hidden="true"></span>
      <span data-theme-label>DARK</span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector('[data-theme-toggle]');

  if (btn) {
    const label = btn.querySelector('[data-theme-label]');
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const CHROME = { light: '#f7f5f0', dark: '#14130e' };

    /** What the reader is actually looking at right now. */
    function resolved() {
      const pinned = root.dataset.theme;
      if (pinned === 'dark' || pinned === 'light') return pinned;
      return media.matches ? 'dark' : 'light';
    }

    /** Sync everything that is downstream of the resolved theme. */
    function sync() {
      const now = resolved();
      const next = now === 'dark' ? 'light' : 'dark';

      label.textContent = next.toUpperCase();
      btn.setAttribute('aria-label', `Switch to ${next} theme`);

      for (const tag of document.querySelectorAll('meta[name="theme-color"]')) {
        tag.content = CHROME[now];
      }

      // Figure.astro re-tunes its light budget on this.
      document.dispatchEvent(
        new CustomEvent('themechange', { detail: { theme: now } }),
      );
    }

    btn.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';

      // Picking the theme the system already asks for drops the pin
      // instead of setting it — so a reader who toggles back ends up
      // following their system again, not frozen on a value that
      // happens to match today.
      if ((next === 'dark') === media.matches) {
        delete root.dataset.theme;
        try {
          localStorage.removeItem('theme');
        } catch (e) {
          /* storage unavailable — the choice lasts this page only */
        }
      } else {
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* same */
        }
      }
      sync();
    });

    // System flips while the tab is open. Only meaningful when unpinned,
    // but sync() reads the pin itself, so it is safe to call either way.
    media.addEventListener('change', sync);

    btn.hidden = false;
    sync();
  }
</script>

<style>
  .nav {
    border-bottom: 1px solid var(--hairline);
  }
  .nav__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
  }
  .nav__mark {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    list-style: none;
    padding: 0;
    justify-content: flex-end;
  }
  .nav__link {
    text-decoration: none;
    color: var(--ink-mid);
  }
  .nav__link:hover {
    color: var(--ink);
  }

  /* Theme toggle. Reads as one more item in the mono row rather than a
   * widget: no icon font, no pill, no sliding switch. `.meta` already
   * supplies the family, size, tracking and caps — the rules here only
   * undo what the UA imposes on <button>. */
  .nav__theme {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: none;
    padding: 0;
    margin-left: 4px;
    line-height: 1;
    color: var(--ink-mid);
    cursor: pointer;
    white-space: nowrap;
  }
  .nav__theme[hidden] {
    display: none;
  }
  .nav__theme:hover {
    color: var(--ink);
  }

  /* A square split down the middle — the printer's mark for contrast.
   * Drawn in currentColor, so it inverts with the theme for free and
   * needs no state of its own. */
  .nav__swatch {
    position: relative;
    width: 9px;
    height: 9px;
    border: 1px solid currentColor;
    flex: none;
  }
  .nav__swatch::before {
    content: '';
    position: absolute;
    inset: 0 50% 0 0;
    background: currentColor;
  }

</style>
