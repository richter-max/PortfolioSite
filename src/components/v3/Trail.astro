---
// Trail.astro — "The way there": every start since the first result and
// every one up to the main event, as stations on a trail at night. With
// JS and motion allowed, the page goes dark and a headlamp beam follows
// the trail while you scroll (the mouse turns your head a little). After
// the main event the night lifts. Without JS or with reduced motion the
// section is simply lit. Everything comes from the races collection, so
// it needs no care. This is the one place for the races: results and
// plans sit here, the stories in the reports.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { toHours, type RaceResult, type UpcomingRace } from '../../data/races';

// Same deterministic generator as motion.js, so the stones never move.
const rng = (seed: number) => {
  let v = seed >>> 0;
  return () => {
    v = (v * 1664525 + 1013904223) >>> 0;
    return v / 4294967296;
  };
};

interface Props {
  upcoming: UpcomingRace[];
  results: RaceResult[];
}
const { upcoming, results } = Astro.props;

interface Station {
  kind: 'past' | 'now' | 'ahead' | 'main';
  label: string;
  name: string;
  fig: string;
  sub?: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  caption?: string;
  /** Race format, printed on an unworn bib while there is no photo yet. */
  format?: string;
  /** Start time and place, printed on the bib's chip strip. */
  start?: { time: string; place?: string };
  /** Plan vs. result on one scale (0..1), for races with a time goal. */
  bar?: { result: number; plan: number };
}

const goalText = (goal?: string) => {
  if (!goal) return undefined;
  if (!toHours(goal)) return goal;
  return /^sub/i.test(goal) ? `goal ${goal.replace(/^sub-?/i, 'sub-')}` : `plan ${goal}`;
};

const past: Station[] = [...results].reverse().map((r) => {
  const res = toHours(r.result);
  const plan = toHours(r.goal);
  const max = Math.max(res ?? 0, plan ?? 0);
  return {
    kind: 'past',
    label: r.dateLabel,
    name: r.name,
    fig: r.result,
    sub: goalText(r.goal),
    href: r.href,
    image: r.image,
    imageAlt: r.imageAlt,
    caption: r.caption,
    bar: res && plan ? { result: res / max, plan: plan / max } : undefined,
  };
});

// No photo yet for a race ahead: a small card drawn from its format.
// Original graphics only, no race logos (trademarks).
type Glyph =
  | { kind: 'tri'; legs: { name: string; km: number }[] }
  | { kind: 'climb'; up: string; path: string }
  | { kind: 'road'; km: string };
const glyphOf = (format?: string): Glyph | undefined => {
  if (!format) return undefined;
  const tri = format.match(/([\d.]+)\s*\/\s*([\d.]+)\s*\/\s*([\d.]+)/);
  if (tri) {
    const km = tri.slice(1, 4).map(Number);
    return { kind: 'tri', legs: ['Swim', 'Bike', 'Run'].map((name, i) => ({ name, km: km[i] })) };
  }
  const up = format.match(/([\d,.]+)\s*m up/);
  if (up) {
    const g = rng(4850);
    let y = 80;
    const pts = Array.from({ length: 23 }, (_, i) => {
      y = Math.min(88, Math.max(14, y + (g() - 0.52) * 34));
      return `${(i * 100) / 22},${y.toFixed(1)}`;
    });
    return { kind: 'climb', up: up[1], path: `M${pts.join(' L')}` };
  }
  const km = format.match(/([\d.]+)\s*km/);
  return km ? { kind: 'road', km: km[1] } : undefined;
};

// Printed on the main event's bib: a stylised night of climbs, ending low
// in the valley at the finish. Not the real course.
const BIB_CLIMB = 'M0,90 L7,78 L12,83 L20,52 L27,62 L35,30 L42,48 L48,40 L56,14 L63,36 L70,28 L78,54 L86,62 L93,80 L100,88';

const mainIdx = upcoming.findIndex((r) => r.weight === 'main');
const ahead: Station[] = upcoming.slice(0, mainIdx + 1).map((r) => ({
  kind: r.weight === 'main' ? 'main' : 'ahead',
  label: r.dateLabel,
  name: r.name,
  fig: r.target ?? r.format,
  // The format is shown once: as the card when there is no photo, else as text.
  sub: r.weight === 'main' ? 'The finish in Fieberbrunn comes after sunrise.' : r.image || !glyphOf(r.format) ? r.format : undefined,
  image: r.image,
  imageAlt: r.imageAlt,
  caption: r.caption,
  format: r.format,
  start: /midnight/i.test(r.note ?? '') ? { time: '00:00', place: r.note?.match(/\bin ([A-ZÄÖÜ][\wäöüß-]+)/)?.[1] } : undefined,
}));
// What comes after the main event, told after the sunrise.
const after = upcoming.slice(mainIdx + 1);

// "You are here". The numbers live in the training block right below.
const now: Station = {
  kind: 'now',
  label: 'Now',
  name: 'You are here',
  fig: 'Training',
  sub: `Every week of it is right below the sunrise.`,
};

const stations = [...past, now, ...ahead];
const n = stations.length;

// Trail geometry, shared with trail.js: t runs 0..1 down the section;
// station i sits at t = (i + 1.1) / (n + 1.6), where the curve is at its
// outermost point, alternating sides.
const phase = (t: number) => Math.PI * (t * (n + 1.6) - 0.6);
const xWide = (t: number) => 0.5 + 0.16 * Math.sin(phase(t));
const xNarrow = (t: number) => 0.09 + 0.03 * Math.sin(phase(t));
const path = (x: (t: number) => number) =>
  Array.from({ length: 241 }, (_, i) => {
    const t = i / 240;
    return `${i ? 'L' : 'M'}${(x(t) * 100).toFixed(2)},${(t * 1000).toFixed(1)}`;
  }).join(' ');
const tOf = (i: number) => (i + 1.1) / (n + 1.6);

// Stones beside the trail (wide layout only), deterministic.
const r = rng(204);
const stones = Array.from({ length: 46 }, () => {
  const t = r();
  const side = r() < 0.5 ? -1 : 1;
  return {
    x: (xWide(t) + side * (0.035 + r() * 0.09)) * 100,
    y: t * 100,
    s: 3 + r() * 9,
  };
});

// The mountains at the end, in front of the sunrise. Filled with the page
// colour, so the night ends on the next section without a seam.
const rr = rng(2027);
const ridge = (() => {
  const pts: string[] = [];
  let y = 18;
  for (let i = 0; i <= 40; i++) {
    y = Math.min(26, Math.max(4, y + (rr() - 0.5) * 7));
    pts.push(`${(i * 2.5).toFixed(1)},${y.toFixed(1)}`);
  }
  return `M0,30 L${pts.join(' L')} L100,30 Z`;
})();

const pct = (v: number) => `${(v * 100).toFixed(2)}%`;

// Phones: stations sit in normal flow (each as tall as its card), so the
// trail is drawn per station: a half-wave from its dot down to the next
// one, stretched to whatever height the station ends up with.
const seg = (a: number, b: number) =>
  Array.from({ length: 25 }, (_, i) => {
    const u = i / 24;
    const x = a + ((b - a) * (1 - Math.cos(Math.PI * u))) / 2;
    return `${i ? 'L' : 'M'}${(x * 100).toFixed(2)},${(u * 100).toFixed(1)}`;
  }).join(' ');
const xn = stations.map((_, i) => xNarrow(tOf(i)));
const leadPath = seg(xNarrow(0), xn[0]);
---

<section id="season" class="trail" aria-labelledby="trail-h" data-trail data-n={n} style={`--n:${n}`}>
  <div class="trail__stage" aria-hidden="true">
    <canvas class="trail__beam" data-trail-beam></canvas>
  </div>

  <div class="trail__ground" aria-hidden="true">
    <svg class="trail__svg is-wide" viewBox="0 0 100 1000" preserveAspectRatio="none">
      <path d={path(xWide)} class="trail__band"></path>
      <path d={path(xWide)} class="trail__dash"></path>
    </svg>
    <svg class="trail__svg is-narrow" viewBox="0 0 100 1000" preserveAspectRatio="none">
      <path d={path(xNarrow)} class="trail__band"></path>
      <path d={path(xNarrow)} class="trail__dash"></path>
    </svg>
    {stones.map((st) => (
      <span class="trail__stone" style={`left:${st.x.toFixed(2)}%;top:${st.y.toFixed(2)}%;--s:${st.s.toFixed(1)}px`}></span>
    ))}
    <div class="trail__dawn"></div>
    <svg class="trail__ridge" viewBox="0 0 100 30" preserveAspectRatio="none"><path d={ridge}></path></svg>
  </div>

  <header class="trail__head wrap">
    <svg class="trail__seg trail__lead" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d={leadPath} class="trail__band"></path>
      <path d={leadPath} class="trail__dash"></path>
    </svg>
    <h2 id="trail-h" class="label">The way there · {past.length} starts behind, {ahead.length} ahead</h2>
    <p class="display-l">From the first finish line to the start in Kitzbühel.</p>
  </header>

  <ol class="trail__list">
    {stations.map((st, i) => {
      const t = tOf(i);
      const right = Math.sin(phase(t)) > 0;
      return (
        <li
          class:list={['trail__st', `is-${st.kind}`, right ? 'is-right' : 'is-left', { 'has-bib': !st.image && !!glyphOf(st.format) }]}
          style={`--y:${i + 1.1};--xw:${pct(xWide(t))};--xn:${pct(xNarrow(t))}`}
          data-trail-st
        >
          <svg class="trail__seg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path d={seg(xn[i], xn[i + 1] ?? xn[i])} class="trail__band"></path>
            <path d={seg(xn[i], xn[i + 1] ?? xn[i])} class="trail__dash"></path>
          </svg>
          <span class="trail__dot" aria-hidden="true"></span>
          <div class="trail__card">
            {st.image && (
              <figure class="trail__photo">
                <Image src={st.image} alt={st.imageAlt ?? ''} widths={[128, 256, 480, 720]} sizes="(max-width: 759px) 48vw, 128px" class="trail__img" loading="lazy" quality={70} />
                {st.caption && <figcaption class="label-s">{st.caption}</figcaption>}
              </figure>
            )}
            {!st.image && glyphOf(st.format) && (() => {
              // The race ahead as the bib I'll pin on: same paper as the 204
              // in the hero. After the race, the result and a photo replace it.
              const g = glyphOf(st.format)!;
              const big = g.kind === 'tri' ? String(Math.round(g.legs.reduce((a, l) => a + l.km, 0))) : g.kind === 'climb' ? (st.format?.match(/^([\d.]+)\s*km/)?.[1] ?? '') : g.km;
              const unit = g.kind === 'tri' ? 'km in one day' : g.kind === 'climb' ? `km · ${g.up} m up` : 'km · road';
              const total = g.kind === 'tri' ? g.legs.reduce((a, l) => a + l.km, 0) : 1;
              return (
                <div class="trail__bibswing" aria-hidden="true">
                  <div class:list={['trail__bib', `is-${g.kind}`]}>
                    <span class="trail__pin" style="top:7px;left:7px"></span>
                    <span class="trail__pin" style="top:7px;right:7px"></span>
                    <span class="trail__pin" style="bottom:7px;left:7px"></span>
                    <span class="trail__pin" style="bottom:7px;right:7px"></span>
                    <span class="trail__bibtop"><span>{st.label}</span><span>No. 204</span></span>
                    <span class="trail__bibbar"></span>
                    <span class="trail__bibmid">
                      {g.kind === 'climb' && (
                        <svg viewBox="0 0 100 100" preserveAspectRatio="none"><path class="trail__bibfill" d={`${BIB_CLIMB} L100,100 L0,100 Z`} /><path d={BIB_CLIMB} /></svg>
                      )}
                      {g.kind === 'road' && <span class="trail__bibticks"></span>}
                      <span class="trail__bibnum">{big}</span>
                      <span class="trail__bibunit">{unit}</span>
                    </span>
                    {g.kind === 'tri' && (
                      <span class="trail__biblegs">
                        {g.legs.map((l, i) => (
                          <span class:list={['trail__bibleg', { 'is-ink': i === 1 }]} style={`flex:${Math.max(0.9, Math.sqrt(l.km / total) * 3).toFixed(2)}`}>{l.name} {l.km}</span>
                        ))}
                      </span>
                    )}
                    {st.start && (
                      <span class="trail__bibchip"><span>Start</span><span class="trail__bibtime">{st.start.time}</span><span>{st.start.place}</span></span>
                    )}
                    <span class="trail__bibstrip"><span>Richter</span><span>Not yet run</span></span>
                  </div>
                </div>
              );
            })()}
            {(st.image || !glyphOf(st.format)) && <span class="label">{st.label}</span>}
            <h3 class="trail__name">{st.name}</h3>
            <span class="trail__fig">{st.fig}</span>
            {st.bar && (
              <span class="trail__bar" role="img" aria-label={`Result against ${st.sub}`}>
                <span class="trail__barfill" style={`width:${(st.bar.result * 100).toFixed(1)}%`}></span>
                <span class="trail__bartick" style={`left:${(st.bar.plan * 100).toFixed(1)}%`}></span>
              </span>
            )}
            {st.sub && <span class="trail__sub">{st.sub}</span>}
            {st.kind === 'now' && <a class="label-s link" href="#training">Training <span class="arr">↓</span></a>}
            {st.href && <a class="label-s link" href={st.href}>Read the report <span class="arr">→</span></a>}
          </div>
        </li>
      );
    })}
  </ol>

  {after.length > 0 && (
    <p class="trail__after wrap label">
      After that: {after.map((r) => `${r.name}, ${r.dateLabel.toLowerCase().replace(/^\w/, (c) => c.toUpperCase())}${r.note ? `. ${r.note}` : ''}`).join(' · ')}
    </p>
  )}
</section>

<script>
  import '../../scripts/v3/trail.js';
</script>

<style>
  .trail {
    --step: 58vh;
    --night: #060605;
    position: relative;
    height: calc((var(--n) + 1.6) * var(--step));
    background: var(--night);
    overflow: clip;
  }
  @supports (height: 1svh) {
    .trail {
      --step: 58svh;
    }
  }

  /* Darkness with the beam cut out. Sticky, so it covers the viewport
     while the section passes; only shown once JS has turned the night on. */
  .trail__stage {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    margin-bottom: -100svh;
    pointer-events: none;
    display: none;
  }
  .trail.is-night .trail__stage {
    display: block;
  }
  .trail__beam {
    width: 100%;
    height: 100%;
    animation: flicker 3.4s steps(1) infinite;
  }
  @keyframes flicker {
    47% {
      opacity: 0.94;
    }
    48% {
      opacity: 0.86;
    }
    49% {
      opacity: 1;
    }
  }

  /* The ground: a faint texture you only see where the light falls. */
  .trail__ground {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(circle, #23221f 1.1px, transparent 1.6px);
    background-size: 19px 23px;
  }
  .trail__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .trail__band {
    fill: none;
    stroke: #201f1c;
    stroke-width: 64px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .trail__dash {
    fill: none;
    stroke: #77736c;
    stroke-width: 1.5px;
    stroke-dasharray: 5 13;
    vector-effect: non-scaling-stroke;
  }
  .trail__svg.is-narrow,
  .trail__seg {
    display: none;
  }
  .trail__stone {
    position: absolute;
    width: var(--s);
    height: calc(var(--s) * 0.7);
    border-radius: 45% 55% 40% 50%;
    background: #34322e;
    transform: translate(-50%, -50%);
  }
  /* The night lifts after the main event: a low glow on the horizon. */
  .trail__dawn {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--step) * 1.9);
    background:
      radial-gradient(ellipse 60% 55% at 50% 88%, rgb(255 248 230 / 0.2), rgb(255 248 230 / 0) 70%),
      linear-gradient(to bottom, rgb(255 248 230 / 0), rgb(255 248 230 / 0.06) 80%);
  }
  .trail__ridge {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: calc(var(--step) * 0.55);
    fill: var(--surface);
  }

  .trail__head {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--step) * 0.22);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .trail__head p {
    margin: 0;
    max-width: 14ch;
  }

  .trail__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .trail__st {
    position: absolute;
    z-index: 2;
    top: calc(var(--y) * var(--step));
    left: 0;
    right: 0;
    transition: opacity 0.7s var(--ease-settle);
  }
  .trail__dot {
    position: absolute;
    left: var(--xw);
    top: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--night);
    transform: translate(-50%, -50%);
  }
  .is-now .trail__dot,
  .is-main .trail__dot {
    background: var(--lamp);
    border-color: var(--lamp);
    box-shadow: 0 0 22px rgb(255 248 230 / 0.6);
  }
  .is-past .trail__dot {
    background: var(--ink);
  }
  .trail__card {
    position: absolute;
    top: 0;
    width: min(440px, 40vw);
    transform: translateY(-34px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .is-right .trail__card {
    right: calc(100% - var(--xw) + 44px);
    align-items: flex-end;
    text-align: right;
  }
  .is-left .trail__card {
    left: calc(var(--xw) + 44px);
  }
  .trail__photo {
    margin: 0 0 6px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 200px;
  }
  .is-right .trail__photo {
    align-items: flex-end;
  }
  .trail__photo figcaption {
    line-height: 1.4;
  }
  /* A race ahead: the unworn bib, paper like the 204 in the hero. It
     sways a little once the headlamp reaches it. */
  .trail__bibswing {
    width: 270px;
    margin-bottom: 14px;
    transform-origin: 50% 0;
    transform: rotate(var(--tilt, -2.5deg));
  }
  .is-right .trail__bibswing {
    --tilt: 2deg;
  }
  .is-main .trail__bibswing {
    width: 320px;
    --tilt: -1.5deg;
  }
  .trail.is-night .is-lit .trail__bibswing {
    animation: bibsway 5s ease-in-out infinite;
  }
  @keyframes bibsway {
    50% {
      transform: rotate(calc(var(--tilt, -2.5deg) + 1.4deg)) translateY(3px);
    }
  }
  .trail__bib {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    aspect-ratio: 5 / 6;
    padding: 9% 7% 6%;
    border-radius: var(--radius-object);
    background: var(--paper);
    color: var(--paper-ink);
    box-shadow: var(--shadow-object);
    text-align: left;
  }
  .is-main .trail__bib {
    box-shadow:
      0 0 70px rgb(255 248 230 / 0.16),
      var(--shadow-object);
  }
  .trail__pin {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, #7d8086 70%);
  }
  .trail__bibtop,
  .trail__bibstrip,
  .trail__bibunit,
  .trail__bibleg,
  .trail__bibchip {
    font-family: var(--font-mono);
    font-size: max(9px, 4.2cqw);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .trail__bibtop,
  .trail__bibstrip {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-inline: 3%;
  }
  .trail__bibbar {
    height: 3.4cqw;
    margin-top: 4cqw;
    background: var(--paper-ink);
  }
  .trail__bibmid {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2cqw;
  }
  .trail__bibmid svg {
    order: 3;
    display: block;
    width: calc(100% + 16cqw);
    height: 24cqw;
    margin: 2cqw -8cqw 0;
  }
  /* 42 km marks on the marathon bib, every fifth one longer */
  .trail__bibticks {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4cqw;
    height: 5cqw;
    background:
      repeating-linear-gradient(90deg, var(--paper-ink) 0 1px, transparent 1px calc(100% / 42)) bottom / 100% 45% no-repeat,
      repeating-linear-gradient(90deg, var(--paper-ink) 0 1.5px, transparent 1.5px calc(500% / 42)) bottom / 100% 100% no-repeat;
  }
  .is-climb .trail__bibmid {
    justify-content: flex-start;
    padding-top: 5cqw;
  }
  .trail__bibmid svg path {
    fill: none;
    stroke: var(--paper-ink);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .trail__bibmid svg .trail__bibfill {
    fill: #e2dfd8;
    stroke: none;
  }
  .trail__bibnum {
    position: relative;
    font-family: var(--font-display);
    font-stretch: 62%;
    font-weight: 800;
    font-size: 40cqw;
    line-height: 0.8;
    letter-spacing: -0.02em;
  }
  .is-road .trail__bibnum {
    font-size: 34cqw;
  }
  .is-climb .trail__bibnum {
    font-size: 52cqw;
  }
  .trail__bibunit {
    position: relative;
  }
  .trail__biblegs {
    display: flex;
    gap: 2.4cqw;
    margin-bottom: 4cqw;
  }
  .trail__bibleg {
    padding: 2.4cqw 0;
    text-align: center;
    white-space: nowrap;
    border: 1.5px solid var(--paper-ink);
    border-radius: 3px;
    font-size: max(8px, 3.6cqw);
    letter-spacing: 0.06em;
  }
  .trail__bibleg.is-ink {
    background: var(--paper-ink);
    color: var(--paper);
  }
