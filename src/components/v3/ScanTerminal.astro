---
// ScanTerminal.astro — this site, scanned by my own Attack Surface
// Scanner. Data: src/data/scan.json, written weekly by the "Scan this
// site" workflow. Every line is a fact from the last scan. The lines type
// out on load; without JS or with reduced motion they are simply there.

import { SITE } from '../../data/site';
import { projects, roadmap, aegis, degree, blockRange } from '../../data/offtrack';

interface Header { name: string; present: boolean }
interface Scan {
  scannedAt: string;
  target: string;
  discovery: string;
  hosts: number;
  resolved: number;
  outOfScopeRejected: number;
  durationSeconds: number | null;
  apex: null | {
    https: boolean;
    redirectsToHttps: boolean;
    httpReachable: boolean;
    tls: string[];
    certificateDaysLeft: number | null;
    headers: Header[];
    risk: string;
  };
  findings: { high: number; medium: number; low: number };
  warnings: string[];
}

interface Props {
  scan: Scan;
}
const { scan } = Astro.props;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const d = new Date(scan.scannedAt);
const date = `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
const a = scan.apex;
const ok = (b: boolean) => (b ? '✓' : '✗');
const short: Record<string, string> = {
  'Strict-Transport-Security': 'hsts',
  'Content-Security-Policy': 'csp',
  'X-Frame-Options': 'x-frame',
  'X-Content-Type-Options': 'nosniff',
  'Referrer-Policy': 'referrer',
};
const total = scan.findings.high + scan.findings.medium + scan.findings.low;

const lines: { k: string; v: string; kind?: 'cmd' | 'gap' | 'result' | 'warn' }[] = [
  { k: '$ ', v: `asm ${scan.target}`, kind: 'cmd' },
  { k: '', v: '', kind: 'gap' },
  { k: 'scope', v: `${scan.target} · ${scan.outOfScopeRejected} out-of-scope host${scan.outOfScopeRejected === 1 ? '' : 's'} rejected` },
  { k: 'hosts', v: `${scan.hosts} found via ${scan.discovery} · ${scan.resolved} resolved` },
  ...(a
    ? [
        { k: 'https', v: a.redirectsToHttps ? 'http redirects to https ✓' : a.https ? 'https ✓ · no redirect from http' : 'no https ✗' },
        ...(a.tls.length ? [{ k: 'tls', v: a.tls.join(', ') }] : []),
        ...(a.certificateDaysLeft != null ? [{ k: 'certificate', v: `valid · ${a.certificateDaysLeft} days left` }] : []),
        { k: 'headers', v: a.headers.map((h) => `${short[h.name] ?? h.name} ${ok(h.present)}`).join('  ') },
      ]
    : []),
  ...scan.warnings.map((w) => ({ k: 'warning', v: w, kind: 'warn' as const })),
  { k: '', v: '', kind: 'gap' },
  {
    k: 'findings',
    v: total === 0 ? '0 · nothing to report' : `${scan.findings.high} high · ${scan.findings.medium} medium · ${scan.findings.low} low`,
    kind: 'result',
  },
];

// What the interactive prompt can answer. Everything here is already on
// the page; the terminal is another way in, not new information.
const cmdData = {
  scan: { date, total, target: scan.target },
  email: SITE.author.email,
  github: SITE.author.github,
  projects: [{ name: 'AEGIS', text: 'Evaluation harness for agent security.' }, ...projects.map((p) => ({ name: p.name, text: p.text.split('. ')[0] + '.' }))],
  roadmap: roadmap.map((r) => ({ state: r.state, what: r.what })),
  aegis: aegis.setups.map((x) => ({ label: x.label, through: x.through, blocked: x.blocked })),
  blocks: degree.years.flatMap((y, yi) => y.blocks.map(([, name], qi) => ({ name, ...blockRange(yi * 4 + qi) }))),
};
const chips = ['help', 'whoami', 'degree', 'projects', 'aegis', 'roadmap', 'contact'];
---

<figure class="term" aria-label={`Attack Surface Scanner run against ${scan.target} on ${date}: ${total} findings.`}>
  <div class="term__bar">
    <span>asm · passive · {date}</span>
  </div>
  <div class="term__body">
    {lines.map((l, i) => (
      <div class:list={['term__line', l.kind && `is-${l.kind}`]} style={`--i:${i}`}>
        {l.kind !== 'gap' && <span class="term__k">{l.k}</span>}
        <span>{l.v}</span>
      </div>
    ))}
    <span class="term__caret" aria-hidden="true" data-term-caret></span>
    <div class="term__out" data-term-out aria-live="polite"></div>
    <form class="term__prompt" data-term-form hidden>
      <label for="term-in" class="term__k">$</label>
      <input id="term-in" name="cmd" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" aria-label="Type a command, for example help" placeholder="type help" />
    </form>
  </div>
  <div class="term__chips" data-term-chips hidden>
    {chips.map((c) => <button type="button" data-cmd={c}>{c}</button>)}
  </div>
  <script type="application/json" data-term-data set:html={JSON.stringify(cmdData)} />
  <figcaption class="label-s term__cap">
    <span>Re-run every Monday by GitHub Actions</span>
    <a class="link" href="https://github.com/richter-max/attack-surface-scanner">The scanner <span class="arr">↗</span></a>
  </figcaption>
</figure>

<script>
  import '../../scripts/v3/term.js';
</script>

<style>
  .term {
    margin: 0;
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .term__bar {
    display: flex;
    gap: var(--space-3);
    padding: 12px 18px;
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    background: #0c0c0b;
    color: #8f8b84;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-bottom: 1px solid #2c2b28;
  }
  .term__body {
    margin-top: calc(-1 * var(--space-3));
    padding: 16px 18px 20px;
    border-radius: 0 0 var(--radius-panel) var(--radius-panel);
    background: #0c0c0b;
    color: #edebe6;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
    overflow-x: auto;
    box-shadow: var(--shadow-object);
  }
  /* key column + value column; long values wrap instead of scrolling */
  .term__line {
    display: grid;
    grid-template-columns: 12ch minmax(0, 1fr);
    column-gap: 1ch;
    /* hidden while the animation runs, shown when it ends: no fill */
    animation: type calc(0.5s + var(--i) * 0.22s) linear;
  }
  @keyframes type {
    from,
    to {
      visibility: hidden;
    }
  }
  .term__k {
    color: #8f8b84;
  }
  .is-cmd {
    grid-template-columns: 2ch minmax(0, 1fr);
  }
  .is-cmd,
  .is-cmd .term__k {
    color: #edebe6;
    font-weight: 500;
  }
  .is-gap {
    height: 8px;
  }
  .is-warn {
    color: #fff8e6;
  }
  .is-result {
    display: inline-grid;
    margin-top: 4px;
    padding: 1px 8px;
    background: #edebe6;
    color: #0c0c0b;
  }
  .is-result .term__k {
    color: #5e5a53;
  }
  .term__caret {
    display: inline-block;
    width: 8px;
    height: 15px;
    margin-top: 6px;
    background: #edebe6;
    vertical-align: -2px;
    animation: blink 1s steps(2) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .term__cap {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .term__cap a {
    color: var(--ink);
    white-space: nowrap;
  }
  .term.is-live .term__caret {
    display: none;
  }
  .term__out {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .term__out:empty {
    display: none;
  }
  .term__out .is-in {
    margin-top: 10px;
    color: #edebe6;
    font-weight: 500;
  }
  .term__out .is-res {
    color: #c9c6bf;
  }
  .term__out a {
    color: #fff8e6;
  }
  .term__prompt {
    display: flex;
    align-items: center;
    gap: 1ch;
    margin-top: 10px;
  }
  .term__prompt[hidden],
  .term__chips[hidden] {
    display: none;
  }
  .term__prompt input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #edebe6;
    font: inherit;
    caret-color: #fff8e6;
    outline: none;
  }
  .term__prompt input::placeholder {
    color: #5e5a53;
  }
  .term__prompt:focus-within {
    box-shadow: 0 1px 0 #fff8e6;
  }
  .term__body.has-out {
    max-height: 520px;
    overflow-y: auto;
  }
  .term__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .term__chips button {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }
  .term__chips button:hover {
    background: var(--ink);
    color: var(--surface);
  }
  @media (max-width: 640px) {
    /* 16px stops iOS from zooming into the field */
    .term__prompt input {
      font-size: 16px;
    }
    .term__body {
      font-size: 11.5px;
    }

  }
  @media (prefers-reduced-motion: reduce) {
    .term__line,
    .term__caret {
      animation: none;
    }
  }
</style>
