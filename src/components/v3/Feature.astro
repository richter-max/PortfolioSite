---
// Feature.astro — one photo, one statement, a few figures.
// Used for the latest short story on a side (currently Rothaarsteig).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  credit?: string;
  label: string;
  title: string;
  figures: { value: string; label: string }[];
  href?: string;
}
const { id, image, imageAlt, caption, credit, label, title, figures, href } = Astro.props;
---

<section class="feature wrap" aria-labelledby={id}>
  <figure class="feature__fig">
    <Image src={image} alt={imageAlt} widths={[520, 1040]} quality={72} sizes="(max-width: 760px) 100vw, 520px" />
    <figcaption class="label-s"><span>{caption}</span>{credit && <span>{credit}</span>}</figcaption>
  </figure>
  <div class="feature__text">
    <p class="label">{label}</p>
    <h2 id={id} class="display-l" set:html={title} />
    <div class="feature__body"><slot /></div>
    <div class="feature__figs">
      {figures.map((f) => (
        <span class="label-s"><span class="stat-m">{f.value}</span>{f.label}</span>
      ))}
    </div>
    {href && <a class="label feature__link link" href={href}>Read the short report <span class="arr">→</span></a>}
  </div>
</section>

<style>
  .feature {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-6) 56px;
  }
  .feature__fig {
    flex: 1 1 320px;
    max-width: 520px;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .feature__fig :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .feature__fig figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .feature__text {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
  }
  .feature__body :global(p) {
    margin: 0;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.65;
  }
  .feature__figs {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .feature__figs .stat-m {
    display: block;
    color: var(--ink);
  }
  .feature__link {
    color: var(--ink);
  }
</style>
