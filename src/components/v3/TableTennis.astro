---
// TableTennis.astro — the season on a paper flip counter, a sibling of the
// race bib and the ID badge. Before the first match the flaps count the
// days to the first serve; after it they show my singles record.
// Data: src/data/tabletennis.json (refreshed every Monday, see
// scripts/fetch-tabletennis.mjs). Script: scripts/v3/scoreboard.js.
import tt from '../../data/tabletennis.json';

const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const ord = (n: number) => n + (n % 100 >= 11 && n % 100 <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] ?? 'th');

const me = tt.me as { singles: string; matches: number } | null;
const next = tt.next as { date: string; time: string | null; home: boolean; opponent: string } | null;
const rating = tt.ttr ? { label: 'TTR', value: tt.ttr } : tt.qttr ? { label: 'Q-TTR', value: tt.qttr } : null;

const nextDate = next ? new Date(`${next.date}T12:00:00Z`) : null;
const nextWhen = nextDate
  ? `${DAYS[nextDate.getUTCDay()]} ${nextDate.getUTCDate()} ${MON[nextDate.getUTCMonth()]}${next?.time ? `, ${next.time}` : ''}`
  : null;

// record mode once I've played; otherwise count down to the next match
const [won, lost] = me ? me.singles.split(':').map((n) => Number(n) || 0) : [0, 0];
const daysTo = nextDate ? Math.max(0, Math.round((nextDate.getTime() - Date.now()) / 864e5)) : 0;
const mode = me ? 'record' : next ? 'countdown' : 'off';
const two = (n: number) => String(Math.min(99, n)).padStart(2, '0').split('');
const label = me ? `My singles this season: ${won} won, ${lost} lost` : next ? `${daysTo} days to the first match` : 'Season not started';
---

<section class="tt wrap" aria-labelledby="tt-h" data-scoreboard data-mode={mode}>
  <div class="tt__text">
    <span class="label">Table tennis · {tt.season}</span>
    <h2 id="tt-h" class="tt__league">{tt.league.split(' ').map((w) => <span>{w}</span>)}</h2>
    <p class="tt__team">
      {tt.team}, first team. Four players, two singles each per match. The board counts mine.
    </p>
    {
      next && (
        <div class="tt__next">
          <span class="label tt__lamp">Next · {nextWhen}</span>
          <span class="tt__who">{next.home ? 'Home vs' : 'Away at'} {next.opponent}</span>
        </div>
      )
    }
    {me && <span class="data tt__muted">Team: {ord(tt.tablePlace)} of 10</span>}
  </div>

  <div class="tt__scene" data-tilt="10">
    <div class="tt__obj" data-tilt-target>
      <div class="board" role="img" aria-label={label}>
        <span class="board__ball" aria-hidden="true"></span>
        <div class="board__top"><span>Richter · singles</span><span>No. 204</span></div>
        <div class="board__bar"></div>
        {
          mode === 'record' ? (
            <div class="board__flaps">
              <div class="board__col">
                <div class="board__pair">
                  {two(won).map((d) => <span class="flap" data-flap data-to={d}>{d}</span>)}
                </div>
                <span class="board__cap">Won</span>
              </div>
              <span class="board__colon" aria-hidden="true">:</span>
              <div class="board__col">
                <div class="board__pair">
                  {two(lost).map((d) => <span class="flap" data-flap data-to={d}>{d}</span>)}
                </div>
                <span class="board__cap">Lost</span>
              </div>
            </div>
          ) : (
            <div class="board__flaps">
              <div class="board__col">
                <div class="board__pair" data-days-flaps={next?.date}>
                  {two(daysTo).map((d) => <span class="flap" data-flap data-to={d}>{d}</span>)}
                </div>
                <span class="board__cap">{next ? 'Days to first serve' : 'Off season'}</span>
              </div>
            </div>
          )
        }
        <p class="board__foot">
          {me ? `${me.matches} ${me.matches === 1 ? 'match' : 'matches'} played` : 'Counting starts on match day 1.'}
        </p>
      </div>
      {
        rating && (
          <div class="tag" aria-label={`${rating.label} ${rating.value}`}>
            <span class="tag__string" aria-hidden="true" />
            <div class="tag__card">
              <span class="tag__label">{rating.label}</span>
              <span class="tag__value">{rating.value}</span>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  import '../../scripts/v3/object.js';
  import '../../scripts/v3/scoreboard.js';
</script>

<style>
  .tt {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: var(--space-8);
  }
  .tt__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }
  .tt__league {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: clamp(48px, 6.4vw, 96px);
    line-height: 1;
    text-transform: uppercase;
    hyphens: manual;
  }
  .tt__league span {
    display: block;
  }
  .tt__team {
    margin: 0;
    max-width: 40ch;
    font-size: 16px;
    line-height: 1.6;
  }
  .tt__next {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .tt__lamp {
    color: var(--lamp);
  }
  .tt__who {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .tt__muted {
    color: var(--ink-muted);
  }

  /* ── the object ─────────────────────────────────────────────────── */
  .tt__scene {
    perspective: 1400px;
    justify-self: center;
    width: min(100%, 500px);
    padding-bottom: 150px; /* room for the hanging tag */
  }
  .tt__obj {
    position: relative;
    transition: transform 0.3s ease-out;
  }
  .board {
    position: relative;
    box-sizing: border-box;
    padding: 20px clamp(16px, 4vw, 26px) 22px;
    border-radius: 10px;
    background: var(--paper);
    color: var(--paper-ink);
    box-shadow: var(--shadow-object), inset 0 -6px 0 #d9d5cc;
    transform: rotate(-2deg);
    overflow: hidden;
  }
  .board__top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .board__bar {
    height: 8px;
    margin: 10px 0 clamp(16px, 4vw, 22px);
    background: var(--paper-ink);
  }
  .board__flaps {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(4px, 1.4vw, 10px);
  }
  .board__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .board__pair {
    display: flex;
    gap: clamp(3px, 1vw, 6px);
  }
  .board__cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .board__colon {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    font-size: clamp(56px, 13vw, 96px);
    line-height: clamp(86px, 21.5vw, 140px);
  }
  .flap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(54px, 13.5vw, 88px);
    height: clamp(86px, 21.5vw, 140px);
    border-radius: 6px;
    background: linear-gradient(#1b1b1a 0 49.4%, #000 49.4% 50.6%, #141413 50.6%);
    color: var(--ink);
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    font-size: clamp(78px, 19vw, 128px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    box-shadow:
      inset 0 1px 0 #2c2c2a,
      0 2px 0 #000;
  }
  :global(.flap.is-flip) {
    animation: flap 0.42s cubic-bezier(0.3, 1.5, 0.45, 1);
  }
  @keyframes flap {
    from {
      transform: perspective(500px) rotateX(-88deg);
      filter: brightness(0.4);
    }
  }
  .board__foot {
    margin: clamp(16px, 4vw, 22px) 0 0;
    padding-top: 12px;
    border-top: 2px dashed var(--paper-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #5e5a53;
  }
  /* after a new record: a ball of light rolls once along the top edge */
  .board__ball {
    position: absolute;
    top: 4px;
    left: -20px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lamp);
    box-shadow: 0 0 18px 6px rgba(255, 248, 230, 0.55);
    opacity: 0;
  }
  :global(.board__ball.is-rolling) {
    animation: roll 1.3s cubic-bezier(0.4, 0, 0.3, 1);
  }
  @keyframes roll {
    0% {
      left: -20px;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      left: calc(100% + 10px);
      opacity: 0;
    }
  }

  .tag {
    position: absolute;
    right: 14%;
    top: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0;
    animation: swing 4s ease-in-out infinite paused;
  }
  /* only swings while on screen (scoreboard.js sets .is-live) */
  :global(.tt.is-live) .tag {
    animation-play-state: running;
  }
  .tag__string {
    width: 2px;
    height: 36px;
    background: var(--ink-muted);
  }
  .tag__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    min-width: 140px;
    padding: 10px 14px 8px;
    border-radius: 6px;
    background: var(--lamp);
    color: var(--paper-ink);
    box-shadow: 0 0 60px rgba(255, 248, 230, 0.22);
  }
  .tag__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
  }
  .tag__value {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    font-size: 56px;
    line-height: 0.95;
  }
  @keyframes swing {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(2.5deg);
    }
  }

  @media (max-width: 900px) {
    .tt {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
  @media (max-width: 759px) {
    .tt {
      padding-top: var(--space-7);
    }
    .tt__scene {
      padding-bottom: 130px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tag,
    :global(.flap.is-flip),
    :global(.board__ball.is-rolling) {
      animation: none;
    }
  }
</style>
