---
// SeasonList.astro — the upcoming races as a list beside one fixed 4:5
// image window. The main event is selected by default.
import { Image } from 'astro:assets';
import { daysUntil, type UpcomingRace } from '../../data/races';

interface Props {
  races: UpcomingRace[];
}
const { races } = Astro.props;
const first = Math.max(0, races.findIndex((r) => r.weight === 'main'));
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="season" class="season wrap" aria-labelledby="season-h" data-season>
  <div class="season__head">
    <h2 id="season-h" class="label">Season 2027</h2>
    <span class="label">{races.length} starts · one that matters</span>
  </div>
  <div class="season__body">
    <figure class="season__window">
      <div class="season__frame">
        {races.map((r, i) =>
          r.image ? (
            <Image
              src={r.image}
              alt=""
              widths={[460, 920]}
              sizes="(max-width: 900px) 100vw, 460px"
              class:list={['season__layer', { 'is-on': i === first }]}
              data-season-layer
              loading="lazy"
              quality={72}
            />
          ) : (
            <div class:list={['season__layer season__card', { 'is-on': i === first }]} data-season-layer>
              <span class="label-s">One loop · every hour</span>
              <span class="season__fig">{r.cardFigure ?? '—'}</span>
              <span class="label-s">No photo yet</span>
            </div>
          ),
        )}
        <span class="season__count label-s" data-season-count aria-hidden="true">{pad(first + 1)} / {pad(races.length)}</span>
      </div>
      <figcaption class="label-s season__cap" aria-live="polite">
        <span data-season-cap>{races[first]?.caption}</span>
        <span data-season-cap-r>{races[first]?.captionRight}</span>
      </figcaption>
    </figure>

    <div class="season__list">
      {races.map((r, i) => (
        <button
          type="button"
          class="season__row"
          aria-pressed={String(i === first)}
          data-season-row
          data-cap={r.caption ?? ''}
          data-cap-r={r.captionRight ?? ''}
        >
          <span class="season__meta">
            <span>{r.dateLabel}</span>
            <span data-days-until={r.datePrecision === 'day' ? r.date : undefined} data-suffix=" D">
              {r.datePrecision === 'day' ? `${daysUntil(r.date)} D` : r.weight === 'open' ? 'TBD' : `~${daysUntil(r.date)} D`}
            </span>
          </span>
          <span class:list={['season__name', { 'is-main': r.weight === 'main' }]}>{r.name}</span>
          <span class="season__goal">{[r.target, r.note].filter(Boolean).join('. ').replace('..', '.')}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import '../../scripts/v3/season.js';
</script>

<style>
  .season {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .season__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .season__body {
    display: flex;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    gap: var(--space-6) 56px;
    align-items: flex-start;
  }
  .season__window {
    flex: 1 1 360px;
    max-width: 460px;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  @media (min-width: 900px) {
    .season__window {
      position: sticky;
      top: var(--space-5);
    }
  }
  /* Phones: the window sits above the list and stays in view while the
     rows scroll under it, so a tap always shows its picture. */
  @media (max-width: 899px) {
    .season__window {
      position: sticky;
      top: 0;
      z-index: 4;
      max-width: none;
      padding: var(--space-2) 0 var(--space-3);
      background: var(--surface);
    }
    .season .season__frame {
      aspect-ratio: 16 / 10;
    }
    .season .season__frame :global(.season__layer) {
      object-position: 50% 35%;
    }
    .season .season__fig {
      font-size: 88px;
    }
  }
  .season__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-raised);
  }
  .season__frame :global(.season__layer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    clip-path: inset(0 0 100% 0);
    transform: scale(1.08);
    transition:
      clip-path var(--dur-wipe) var(--ease-wipe),
      transform 1.6s var(--ease-settle);
  }
  .season__frame :global(.season__layer.is-prev) {
    z-index: 2;
    clip-path: inset(0);
  }
  .season__frame :global(.season__layer.is-on) {
    z-index: 3;
    clip-path: inset(0);
    transform: none;
  }
  .season__card {
    box-sizing: border-box;
    padding: 40px 18px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface-raised);
  }
  .season__fig {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 700;
    font-size: clamp(96px, 14vw, 168px);
    line-height: 0.8;
    text-transform: uppercase;
  }
  .season__count {
    position: absolute;
    left: 14px;
    top: 12px;
    z-index: 6;
    color: #edebe6;
    mix-blend-mode: difference;
  }
  .season__cap {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .season__list {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--line);
  }
  .season__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    padding: 22px 0;
    border: 0;
    border-top: 1px solid var(--line);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    color: var(--ink-muted);
    transition:
      color var(--dur-ui),
      padding var(--dur-ui) var(--ease-settle),
      box-shadow var(--dur-ui);
  }
  .season__row[aria-pressed='true'] {
    color: var(--ink);
    padding-left: 20px;
    box-shadow: inset 2px 0 0 var(--line-strong);
  }
  .season__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }
  .season__name {
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    text-transform: uppercase;
    line-height: 0.9;
    font-weight: 500;
    font-size: clamp(36px, 4.2vw, 60px);
  }
  .season__name.is-main {
    font-weight: 800;
    font-size: clamp(48px, 6vw, 88px);
  }
  .season__goal {
    font-size: 15px;
    line-height: 1.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .season__frame :global(.season__layer),
    .season__row {
      transition: none;
    }
  }
</style>
