---
// StatRow.astro — live training numbers from the daily Strava workflow
// (src/data/live-stats.json) plus the countdown to the next start.
import live from '../../data/live-stats.json';
import { daysUntil, type UpcomingRace } from '../../data/races';

interface Props {
  next?: UpcomingRace;
}
const { next } = Astro.props;
const s = live.strava;
const cells = [
  s?.streakWeeks != null && { label: 'Weeks in a row', value: String(s.streakWeeks) },
  s?.sessionsThisYear != null && {
    label: `Sessions ${new Date(live.updatedAt).getFullYear()}`,
    value: String(s.sessionsThisYear),
  },
  s?.lastRun && { label: `Last run · ${s.lastRun.weekday}`, value: `${s.lastRun.km} km` },
  next && {
    label: `Days to ${next.name.split(' ')[0]}`,
    value: String(daysUntil(next.date)),
    days: next.date,
  },
].filter(Boolean) as { label: string; value: string; days?: string }[];
---

<section class="stats wrap" aria-label="Training numbers">
  <div class="stats__row">
    {cells.map((c) => (
      <div class="stats__cell">
        <span class="label">{c.label}</span>
        <span class="stat-l" data-days-until={c.days}>{c.value}</span>
      </div>
    ))}
  </div>
  <p class="label-s stats__src">From Strava, updated daily. No routes.</p>
</section>

<style>
  .stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .stats__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .stats__cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 0 24px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 520px) {
    .stats__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
