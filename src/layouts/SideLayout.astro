---
// SideLayout.astro — the v3 page frame. One layout for both sides; the
// side sets <html data-side>, which swaps every colour token. Switching
// sides is an ordinary link between two routes, animated by a
// cross-document view transition (see v3/base.css).
import '../styles/fonts.css';
import '../styles/v3/fonts.css';
import '../styles/v3/tokens.css';
import '../styles/v3/base.css';
import SiteHeader from '../components/v3/SiteHeader.astro';
import SiteFooter from '../components/v3/SiteFooter.astro';
import { SITE } from '../data/site';

interface Props {
  side: 'on' | 'off';
  title?: string;
  description?: string;
  /** Keep this page out of search results (legal pages with a postal address). */
  noindex?: boolean;
  /** Page language; legal pages are German. */
  lang?: 'en' | 'de';
  /** Link-preview image (path under public), e.g. /og/berlin-marathon-2026.png */
  ogImage?: string;
}

const { side } = Astro.props;
const meta = SITE.sides[side];
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;
const noindex = Astro.props.noindex ?? false;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang={Astro.props.lang ?? 'en'} data-side={side}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={side === 'on' ? '#0c0c0b' : '#edebe6'} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(Astro.props.ogImage ?? `/og-${side}.png`, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicons/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Only the display face is preloaded: it sets the hero headline, the
         largest paint. Plex swaps in on its own. -->
    <link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader side={side} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
