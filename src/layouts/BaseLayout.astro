---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicons/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts: preload the two files on the critical path.
         Latin-ext arrives via unicode-range when Allgäu/ä-umlauts render. -->
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Address-bar colour. Two tags cover the no-JS case via media;
         the script below overwrites both with the resolved colour when
         the reader has pinned a theme, so a pinned choice is not
         contradicted by the browser chrome. -->
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14130e" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, SITE.url).href} />
    <meta property="og:image" content={new URL('/img/og.jpg', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/img/og.jpg', SITE.url).href} />

    <!-- Theme resolution, synchronous and before first paint. This is
         the only script on the critical path and it stays that way:
         read the pin, set the attribute, correct the address bar. The
         toggle itself lives in Nav.astro and is deferred like
         everything else. A blocked or empty localStorage (private
         mode, storage disabled) falls through to the system setting
         rather than throwing. -->
    <script is:inline>
      (function () {
        var pinned = null;
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') pinned = stored;
        } catch (e) {
          /* storage unavailable — follow the system */
        }
        if (pinned) document.documentElement.dataset.theme = pinned;

        var dark =
          pinned === 'dark' ||
          (!pinned &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        var color = dark ? '#14130e' : '#f7f5f0';
        var tags = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < tags.length; i++) tags[i].content = color;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
