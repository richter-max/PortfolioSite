---
// ProseLayout.astro — article shell for reports, blog index and legal
// pages, inside the v3 frame. One measured column. Reports sit on the On
// Track side, security and legal pages on the Off Track side.
import SideLayout from './SideLayout.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  metaLine?: string;
  noindex?: boolean;
  side?: 'on' | 'off';
  lang?: 'en' | 'de';
  ogImage?: string;
}
const { title, description, kicker, metaLine, noindex = false, side = 'on', lang = 'en', ogImage } = Astro.props;
---

<SideLayout side={side} title={`${title} — ${SITE.name}`} description={description ?? SITE.sides[side].description} noindex={noindex} lang={lang} ogImage={ogImage}>
  <div class="prosewrap wrap">
    <header class="prose__head">
      {kicker && <p class="label">{kicker}</p>}
      <h1 class="display-l">{title}</h1>
      {metaLine && <p class="label">{metaLine}</p>}
    </header>
    <article class="prose">
      <slot />
    </article>
  </div>
</SideLayout>

<style>
  .prosewrap {
    max-width: 820px;
    padding-block: var(--space-8) 0;
  }
  /* Long German words ("Datenschutzerklärung") must not widen the page */
  .prose__head h1 {
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .prose__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .prose {
    font-size: 17px;
    line-height: 1.7;
    /* long URLs and e-mail addresses must not widen the page on phones */
    overflow-wrap: anywhere;
    /* Names used by the older hand-written posts, mapped to v3 tokens. */
    --hairline: var(--line);
    --hairline-strong: var(--line-strong);
    --ink-mid: var(--ink);
    --ink-low: var(--ink-muted);
    --paper-2: var(--surface-raised);
    --accent: var(--ink);
    --accent-ink: var(--ink);
    --photo-filter: grayscale(1) contrast(1.05);
    --photo-filter-hover: grayscale(1) contrast(1.12);
  }
  .prose :global(h2) {
    margin: 2.2em 0 0.6em;
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-weight: 600;
    font-size: 36px;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .prose :global(h3) {
    margin: 1.8em 0 0.4em;
    font-weight: 500;
    font-size: 18px;
  }
  .prose :global(p) {
    margin-block: 0.9em;
    max-width: 66ch;
  }
  .prose :global(ul),
  .prose :global(ol) {
    max-width: 62ch;
    padding-left: 1.2em;
  }
  .prose :global(li) {
    margin-block: 0.5em;
  }
  .prose :global(address) {
    margin-block: 0.9em;
    font-style: normal;
  }
  .prose :global(strong) {
    font-weight: 500;
  }
  .prose :global(code),
  .prose :global(.mono) {
    padding: 1px 5px;
    background: var(--surface-raised);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .prose :global(hr) {
    margin-block: 2.5em;
    border: none;
    border-top: 1px solid var(--line);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .prose :global(td),
  .prose :global(th) {
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(td:last-child) {
    font-family: var(--font-mono);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .prose :global(.meta) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .prose :global(.data) {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .prose :global(.note) {
    padding-left: 16px;
    border-left: 2px solid var(--ink);
    font-size: 15px;
  }
  .prose :global(.muted) {
    color: var(--ink-muted);
    font-size: 14px;
  }
</style>
